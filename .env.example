# Copy to .env and adjust. Never commit the real .env.

# Main role used by the web app, analyzer and supervisor.
DATABASE_URL=postgresql://sonde_user:change-me@localhost/weather_sonde

# Optional least-privilege role for receiver + parser (see db/raw_schema.sql grants).
# INGEST_DATABASE_URL=postgresql://ingest_user:change-me@localhost/weather_sonde

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# Set to false once your operator accounts exist.
ALLOW_SIGNUP=true

# Inactivity timeout for operator sessions, in minutes.
SESSION_MINUTES=30

# Flask entry point (used by `flask db ...` and the supervisor).
FLASK_APP=run.py

# Web UI bind address/port used by the supervisor.
# FLASK_RUN_HOST=0.0.0.0
# FLASK_RUN_PORT=5000
